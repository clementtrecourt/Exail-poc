Vagrant.configure("2") do |config|
  config.vm.box = "generic/ubuntu2204"

  config.vm.define "vm-prod" do |prod|
    prod.vm.hostname = "vm-prod-01"
    prod.vm.network "private_network", ip: "10.0.0.11", libvirt__network_name: "exail-v2-net"

    prod.vm.provider :libvirt do |lv|
      lv.memory = 1024
      lv.cpus = 1
    end
  end

  config.vm.define "vm-drone" do |drone|
    drone.vm.hostname = "vm-edge-drone-01"
    drone.vm.network "private_network", ip: "10.0.0.12", libvirt__network_name: "exail-v2-net"
    
    drone.vm.provider :libvirt do |lv|
      lv.memory = 1024
      lv.cpus = 1
    end
  end
end