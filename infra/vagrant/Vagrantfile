Vagrant.configure("2") do |config|
  config.vm.box = "generic/ubuntu2204"

    config.vm.define "vm-jenkins" do |jenkins|
    jenkins.vm.hostname = "vm-jenkins"
    jenkins.vm.network "private_network", ip: "10.0.0.10",
      libvirt__network_name: "exail-v2-net"
 
    jenkins.vm.provider :libvirt do |lv|
      lv.memory = 2048
      lv.cpus   = 2
    end
    jenkins.vm.provision "shell", inline: <<-SHELL
      set -e
      echo "=== [1/7] Mise à jour système ==="
      rm -rf /var/lib/apt/lists/*
      sudo sed -i 's|https://mirrors.edge.kernel.org/ubuntu|http://fr.archive.ubuntu.com/ubuntu|g' /etc/apt/sources.list
      apt-get update
 
      echo "=== [2/7] Installation Java 17 (requis Jenkins) ==="
      apt-get install -y --no-install-recommends \
        openjdk-21-jdk \
        curl \
        gnupg2 \
        ca-certificates \
        git \
        make \
        cmake \
        g++ \
        fuse-overlayfs \
        dbus-x11 \
        nodejs \
        uidmap \
        npm
 
     echo "=== [3/7] Installation Jenkins et ses plugins ==="

     curl -fsSL https://pkg.jenkins.io/debian-stable/jenkins.io-2026.key | sudo tee \
        /usr/share/keyrings/jenkins-keyring.asc > /dev/null
     echo deb [signed-by=/usr/share/keyrings/jenkins-keyring.asc] \
        https://pkg.jenkins.io/debian-stable binary/ | sudo tee \
        /etc/apt/sources.list.d/jenkins.list > /dev/null
     apt-get update -y -qq && apt-get install -y jenkins
     curl -fsSL https://github.com/jenkinsci/plugin-installation-manager-tool/releases/download/2.13.0/jenkins-plugin-manager-2.13.0.jar -o /opt/jenkins-plugin-manager.jar
     java -jar /opt/jenkins-plugin-manager.jar --plugins ssh-agent workflow-aggregator git --war /usr/share/java/jenkins.war || true
      echo "=== [4/7] Installation Podman ==="

      echo "jenkins:100000:65536" > /etc/subuid
      echo "jenkins:100000:65536" > /etc/subgid
      
      mkdir -p /var/lib/jenkins/.config/containers
      cat <<EOF > /var/lib/jenkins/.config/containers/storage.conf
[storage]
driver = "overlay"
[storage.options.overlay]
mount_program = "/usr/bin/fuse-overlayfs"
EOF
      chown -R jenkins:jenkins /var/lib/jenkins/.config

      loginctl enable-linger jenkins || true

      apt-get install -y --no-install-recommends podman

      usermod -aG sudo jenkins || true

      echo "=== [5/7] Configuration Git Host Verification ==="

      mkdir -p /var/lib/jenkins/.ssh

      echo "Host *" > /var/lib/jenkins/.ssh/config

      echo "    StrictHostKeyChecking no" >> /var/lib/jenkins/.ssh/config

      chown -R jenkins:jenkins /var/lib/jenkins/.ssh
      
      echo "=== [6/7] Installation Ansible ==="
      apt-get install -y --no-install-recommends \
        ansible \
        python3-pip
      pip3 install --quiet ansible-lint
      sudo -u jenkins ansible-galaxy collection install ansible.posix community.general containers.podman

      echo "=== [6.5/7] Installation Syft (SBOM) ==="
      curl -sSfL https://raw.githubusercontent.com/anchore/syft/main/install.sh | sh -s -- -b /usr/local/bin
      
      echo "=== [7/7] Démarrage Jenkins ==="
      systemctl enable jenkins
      systemctl start jenkins
 
      echo ""
      echo "============================================"
      echo "✅ Jenkins prêt sur http://10.0.0.10:8080"
      echo "Mot de passe initial :"
      echo "$(cat /var/lib/jenkins/secrets/initialAdminPassword 2>/dev/null || echo 'pas encore généré, attendre 30s')"
      echo "============================================"
    SHELL
  end


  config.vm.define "vm-prod" do |prod|
    prod.vm.hostname = "vm-prod-01"
    prod.vm.network "private_network", ip: "10.0.0.11", libvirt__network_name: "exail-v2-net"

    prod.vm.provider :libvirt do |lv|
      lv.memory = 1024
      lv.cpus = 1
    end
    config.vm.provision "shell", inline: <<-SHELL
  mkdir -p /home/vagrant/.ssh
  # Clé publique de Jenkins — à mettre à jour si tu regénères la clé
  echo "ssh-ed25519 AAAA...TA_CLE_PUBLIQUE_JENKINS... jenkins-deploy" \
    >> /home/vagrant/.ssh/authorized_keys
  chmod 700 /home/vagrant/.ssh
  chmod 600 /home/vagrant/.ssh/authorized_keys
  chown -R vagrant:vagrant /home/vagrant/.ssh
SHELL
  end

  config.vm.define "vm-drone" do |drone|
    drone.vm.hostname = "vm-edge-drone-01"
    drone.vm.network "private_network", ip: "10.0.0.12", libvirt__network_name: "exail-v2-net"
    
    drone.vm.provider :libvirt do |lv|
      lv.memory = 1024
      lv.cpus = 1
    end
  end
end