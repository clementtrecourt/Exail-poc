global:
  scrape_interval: 15s

scrape_configs:
  - job_name: 'node_exporter'
    static_configs:
      - targets:
        - "{{ hostvars['vm-prod'].ansible_host }}:9100"
        - "{{ hostvars['vm-drone'].ansible_host }}:9100"
  
  - job_name: 'cadvisor'
    static_configs:
      - targets:
        - "{{ hostvars['vm-prod'].ansible_host }}:8081"
        - "{{ hostvars['vm-drone'].ansible_host }}:8081"
